{
  "name": "library-lens",
  "version": "0.11.25",
  "private": true,
  "license": "PolyForm-Strict-1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "package": "python3 scripts/package.py",
    "build:directory": "python3 scripts/build-library-directory.py",
    "test:retailers": "node scripts/retailer-check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:security": "node scripts/security-check.mjs",
    "check:public": "python3 scripts/check-public-files.py"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "description": "Check selected Seattle-area and Bay Area library catalogs from a book page.",
